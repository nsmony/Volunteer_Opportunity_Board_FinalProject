<%- include('../partials/header', { title: 'Login' }) %>

<section class="form-card auth-card">
  <h1>Welcome back</h1>
  <p>Log in to manage your volunteer opportunities.</p>

  <form method="POST" action="/login">
    <div class="form-group">
      <label for="identifier">Username or email</label>
      <input class="form-control" id="identifier" name="identifier" type="text"
             value="<%= values.identifier %>" autocomplete="username" required>
    </div>

    <div class="form-group">
      <label for="password">Password</label>
      <input class="form-control" id="password" name="password" type="password"
             autocomplete="current-password" required>
    </div>

    <div class="form-actions">
      <button class="btn btn-primary" type="submit">Log in</button>
    </div>
  </form>

  <p class="auth-switch">New to VolunteerBoard? <a href="/register">Create an account</a></p>
</section>

<%- include('../partials/footer') %>
