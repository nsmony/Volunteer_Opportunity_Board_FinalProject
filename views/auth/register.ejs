<%- include('../partials/header', { title: 'Create account' }) %>

<section class="form-card auth-card">
  <h1>Create your account</h1>
  <p>Join your community and start making a difference.</p>

  <form method="POST" action="/register">
    <div class="form-group">
      <label for="username">Username</label>
      <input class="form-control" id="username" name="username" type="text"
             value="<%= values.username %>" minlength="3" maxlength="30"
             pattern="[A-Za-z0-9_]+" autocomplete="username" required>
      <p class="field-hint">3–30 characters; letters, numbers, and underscores.</p>
    </div>

    <div class="form-group">
      <label for="email">Email</label>
      <input class="form-control" id="email" name="email" type="email"
             value="<%= values.email %>" maxlength="100" autocomplete="email" required>
    </div>

    <div class="form-group">
      <label for="password">Password</label>
      <input class="form-control" id="password" name="password" type="password"
             minlength="8" maxlength="72" autocomplete="new-password" required>
      <p class="field-hint">At least 8 characters.</p>
    </div>

    <div class="form-actions">
      <button class="btn btn-primary" type="submit">Create account</button>
    </div>
  </form>

  <p class="auth-switch">Already have an account? <a href="/login">Log in</a></p>
</section>

<%- include('../partials/footer') %>
