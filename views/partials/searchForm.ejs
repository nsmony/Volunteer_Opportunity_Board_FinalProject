<%# Locals: q, category, categories %>
<form action="/opportunities" method="GET" class="search-form">
  <input type="text" name="q" value="<%= q %>" placeholder="Search by keyword" maxlength="100">
  <select name="category">
    <option value="">All categories</option>
    <% categories.forEach(function (c) { %>
      <option value="<%= c.id %>" <%= category === c.id ? 'selected' : '' %>><%= c.name %></option>
    <% }) %>
  </select>
  <button type="submit" class="btn">Search</button>
  <% if (q || category) { %><a href="/opportunities">Clear</a><% } %>
</form>
