<%- include('partials/header', { title: 'Not found' }) %>
<section class="status-page">
  <p class="status-code">404</p>
  <h1>We could not find that page</h1>
  <p class="muted">
    <%= (typeof message !== 'undefined' && message) ? message : 'This page or opportunity does not exist, or it was removed.' %>
  </p>
  <a class="btn btn-primary" href="/opportunities">Back to Browse</a>
</section>
<%- include('partials/footer') %>